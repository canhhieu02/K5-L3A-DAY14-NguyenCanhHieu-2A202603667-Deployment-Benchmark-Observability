# Những gì KHÔNG đưa vào Docker build context / image (tiêu chí 3)

# Secrets — tuyệt đối không để lọt vào image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtualenv
venv/
.venv/
env/

# Git, tài liệu, công cụ không cần lúc chạy
.git/
.gitignore
*.md
check_production_ready.py
benchmark-observability/
screenshots/
reports/
